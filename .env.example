# Copy to .env and fill in. NEVER commit the filled-in file.
# Source it before running:  set -a && . ./.env && set +a && mvn spring-boot:run

# --- LinkedIn session -------------------------------------------------------
# Both values come from your browser's cookies for www.linkedin.com after login.
# DevTools > Application > Cookies > https://www.linkedin.com
#
#   li_at        long opaque session token
#   JSESSIONID   looks like  "ajax:1234567890123456789"  (keep the quotes off)
#
# The service derives the csrf-token header from JSESSIONID automatically.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# --- API auth ---------------------------------------------------------------
# Comma-separated list of accepted keys. Leave EMPTY to disable auth (local dev
# only — the app logs a loud warning when it starts unauthenticated).
API_KEYS=

# --- Tuning -----------------------------------------------------------------
RATE_LIMIT_RPM=30
CACHE_FRESH_TTL=PT6H
CACHE_STALE_TTL=PT24H

# Voyager decoration id. Bump this without a rebuild when LinkedIn ships a new
# version and field mapping starts coming back empty.
VOYAGER_DECORATION_ID=com.linkedin.voyager.dash.deco.identity.profile.FullProfileWithEntities-93

# Optional outbound proxy for the LinkedIn calls, e.g. http://user:pass@host:port
OUTBOUND_PROXY=

PORT=8080
